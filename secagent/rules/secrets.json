[
 {
  "id": "AWS-KEY-ID",
  "title": "AWS access key id",
  "severity": "high",
  "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "AWS-SECRET",
  "title": "AWS secret access key",
  "severity": "critical",
  "pattern": "(?i)aws.{0,20}(secret|key).{0,5}[=:]\\s*[\"']?([A-Za-z0-9/+=]{40})[\"']?",
  "group": 2,
  "min_entropy": 0
 },
 {
  "id": "GITHUB-TOKEN",
  "title": "GitHub token",
  "severity": "critical",
  "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "SLACK-TOKEN",
  "title": "Slack token",
  "severity": "high",
  "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "GOOGLE-API-KEY",
  "title": "Google API key",
  "severity": "high",
  "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "STRIPE-LIVE",
  "title": "Stripe live key",
  "severity": "critical",
  "pattern": "\\b(sk|rk)_live_[0-9a-zA-Z]{20,}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "PRIVATE-KEY",
  "title": "Private key material",
  "severity": "critical",
  "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY( BLOCK)?-----",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "JWT",
  "title": "Hardcoded JWT",
  "severity": "medium",
  "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
  "group": 0,
  "min_entropy": 0
 },
 {
  "id": "URL-CREDS",
  "title": "Credentials inside URL / connection string",
  "severity": "high",
  "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^/\\s:@'\"]+:([^/\\s:@'\"]{3,})@[^/\\s'\"]+",
  "group": 1,
  "min_entropy": 0
 },
 {
  "id": "ENV-FILE-SECRET",
  "title": "Secret value in .env-style file",
  "severity": "high",
  "pattern": "(?i)^\\s*(export\\s+)?[A-Z0-9_]*(SECRET|PASSWORD|PASSWD|PRIVATE_KEY|API_?KEY|ACCESS_?KEY|TOKEN|DATABASE_URL|SERVICE_ROLE)[A-Z0-9_]*\\s*=\\s*[\"']?([^\\s#\"']{8,})",
  "group": 3,
  "min_entropy": 3.0,
  "globs": [
   ".env",
   ".env.*",
   "*.env"
  ],
  "exclude_globs": [
   ".env.example",
   ".env.sample",
   ".env.template",
   "*.example",
   "*.sample",
   "*.template"
  ]
 },
 {
  "id": "GENERIC-SECRET",
  "title": "Hardcoded password/secret/token",
  "severity": "high",
  "pattern": "(?i)\\b(password|passwd|pwd|secret|api[_-]?key|token|auth[_-]?key|access[_-]?key|private[_-]?key)\\b[\"']?\\s*[:=]\\s*[\"']([^\"'\\s]{8,})[\"']",
  "group": 2,
  "min_entropy": 3.0
 }
]